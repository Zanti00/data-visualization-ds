    "dataset": {
      "title": "Enrollment trends of five BS engineering and computing programs at UP Diliman, 2016\u20132026.",
      "description": "Explore program size, share of enrollment, yearly trends, and how programs move together."
    },
    "bar": {
      "title": "Student Population by Program (2026)",
      "description": "This chart compares the number of enrolled students in each of the five programs in 2026. CS leads with 538 students, followed by ECE (504), IE (479), ChE (447), and ME (319). ME is clearly the smallest program, with about 220 fewer students than CS."
    },
    "line": {
      "title": "Enrollment Trend by Program (2016\u20132026)",
      "description": "This chart tracks yearly enrollment for each program over 11 years. All programs dropped after 2016, and total enrollment bottomed out at 1,977 in 2018. CS then grew steadily, peaking at 581 in 2024, and IE rose to its highest level (479) in 2026. ECE, ChE, and ME recovered only partly and remain below their 2016 levels."
    },
    "pie": {
      "title": "Share of Total Enrollment by Program (2026)",
      "description": "This chart shows each program\u2019s percentage of the 2,287 students enrolled across the five programs in 2026. CS holds the largest share (23.5%), then ECE (22.0%), IE (20.9%), ChE (19.5%), and ME (13.9%). Four programs are fairly close in size, while ME\u2019s slice is noticeably smaller."
    },
    "heatmap": {
      "title": "Enrollment Correlation Between Programs",
      "description": "This chart shows how closely the yearly enrollment of each pair of programs moves together, from -1 (opposite directions) to +1 (same direction). The strongest links are ChE with ECE (0.84), ChE with ME (0.77), and CS with IE (0.76). CS has a weak negative relationship with ECE (-0.26) and almost none with ChE (-0.02). With only 11 years of data, these are patterns to investigate, not proof of cause."
    }
  },
